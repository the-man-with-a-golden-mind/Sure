Cover.next.serve_one: Http.Server.serve_one(0, (req) IO.end<Unit>(unit)) == IO {
    get raw = Http.Server.recv(0)
    let parsed = Http.Server.parse(raw)
    case parsed {
      none: IO {
        return false
      }
      some: IO {
        IO.end<Unit>(unit)
        return true
      }
    }
  }
  refl

