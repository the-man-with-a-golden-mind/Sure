        Sure.Ssr.run.go(0, [])
        return Http.Server.ok
      }
    }
  }
  refl

Cover.next.ssr_step: Sure.Ssr.step(0, []) == IO {
    get raw = Http.Server.recv(0)
    let parsed = Http.Server.parse(raw)
    case parsed {
      none: IO {
        return false
      }
      some: IO {
        get r = Sure.Ssr.fire([], parsed.value)
        open parsed.value
        Sure.Ssr.send(parsed.value.id, r)
        return true
      }
    }
  }
  refl

