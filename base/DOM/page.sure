// Full HTML document. The script listens for UI events and posts to /sure/event.
// Never bind error: a capture listener on document intercepts script failures.
DOM.page.script: String
  "<script>(function(){function send(e){var t=e.target;if(!t||!t.getAttribute)return;var msg=t.getAttribute('data-sure-on-'+e.type);if(msg==null)return;var x=e.clientX||0,y=e.clientY||0,btn=e.button||0,val=(t.value==null?'':String(t.value));if(e.type==='scroll')try{val=String((t.scrollTop|0)||0);}catch(_s){val='0';}var key=e.key||'',id=t.id||'';fetch('/sure/event',{method:'POST',headers:{'Content-Type':'text/plain'},body:e.type+'\\n'+msg+'\\n'+id+'\\n'+val+'\\n'+key+'\\n'+btn+'\\n'+x+'\\n'+y+'\\n'+(e.altKey?'1':'0')+'\\n'+(e.ctrlKey?'1':'0')+'\\n'+(e.metaKey?'1':'0')+'\\n'+(e.shiftKey?'1':'0')}).catch(function(){});}var ev=['click','input','change','scroll','mousedown','mousemove','mouseup','keydown','keyup','submit','wheel','pointerdown','pointermove','pointerup','focus','blur','touchstart','touchmove','touchend'];var pass={scroll:1,wheel:1,touchstart:1,touchmove:1,touchend:1};for(var i=0;i<ev.length;i++){var n=ev[i];try{document.addEventListener(n,send,pass[n]?{capture:true,passive:true}:{capture:true});}catch(_a){document.addEventListener(n,send,true);}}}())</script>"

DOM.page(title: String, body: DOM): String
  "<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>" | Html.escape(title) | "</title></head><body>" | DOM.render(body) | DOM.page.script | "</body></html>"
