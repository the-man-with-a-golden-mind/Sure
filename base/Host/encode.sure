Host.encode(op: Host.Op): Pair<String, String>
  case op {
    put_string: Pair.new<String, String>("put_string", op.text)
    get_line: Pair.new<String, String>("get_line", op.prompt)
    get_args: Pair.new<String, String>("get_args", "")
    cwd: Pair.new<String, String>("cwd", "")
    time_now: Pair.new<String, String>("get_time", "")
    sleep: Pair.new<String, String>("sleep", Nat.show(op.ms))
    yield: Pair.new<String, String>("yield", "")
    exit: Pair.new<String, String>("exit", Nat.show(op.code))
    fs_read: Pair.new<String, String>("fs_read_ex", op.path)
    fs_write: Pair.new<String, String>("fs_write_ex", op.path | "\n" | op.body)
    fs_del: Pair.new<String, String>("fs_del_ex", op.path)
    fs_mtime: Pair.new<String, String>("get_file_mtime", op.path)
    fs_dir: Pair.new<String, String>("get_dir_ex", op.path)
    fs_read_hex: Pair.new<String, String>("fs_read_hex", op.path)
    fs_write_hex: Pair.new<String, String>("fs_write_hex", op.path | "\n" | op.hex)
    file_hash: Pair.new<String, String>("file_hash", op.path)
    env_get: Pair.new<String, String>("get_env", op.name)
    env_set: Pair.new<String, String>("set_env", op.name | "\n" | op.val)
    env_del: Pair.new<String, String>("del_env", op.name)
    env_keys: Pair.new<String, String>("env_keys", "")
    random: Pair.new<String, String>("get_random", "")
    sha256: Pair.new<String, String>("sha256_ex", op.text)
    hmac: Pair.new<String, String>("hmac_sha256", op.key | "\n" | op.msg)
    http: Pair.new<String, String>("http", op.payload)
    http_listen: Pair.new<String, String>("http_listen", Nat.show(op.port))
    http_recv: Pair.new<String, String>("http_recv", Nat.show(op.port))
    http_reply: Pair.new<String, String>("http_reply", op.id | "\n" | Nat.show(op.status) | "\n" | op.body)
    http_reply_ex: Pair.new<String, String>("http_reply_ex", op.id | "\n" | Nat.show(op.status) | "\n" | op.ctype | "\n" | op.body)
    http_stop: Pair.new<String, String>("http_stop", Nat.show(op.port))
    dns: Pair.new<String, String>("dns", op.host)
    tcp_connect:
      let flag = if op.tls then "1" else "0"
      Pair.new<String, String>("tcp_connect", op.host | "\n" | Nat.show(op.port) | "\n" | flag)
    tcp_send: Pair.new<String, String>("tcp_send", op.id | "\n" | op.data)
    tcp_recv: Pair.new<String, String>("tcp_recv", op.id)
    tcp_close: Pair.new<String, String>("tcp_close", op.id)
    ws_connect: Pair.new<String, String>("ws_connect", op.url)
    udp_bind: Pair.new<String, String>("udp_bind", Nat.show(op.port))
    udp_send: Pair.new<String, String>("udp_send", Nat.show(op.from) | "\n" | op.ip | "\n" | Nat.show(op.to) | "\n" | op.hex)
    udp_recv: Pair.new<String, String>("udp_recv", Nat.show(op.port))
    udp_close: Pair.new<String, String>("udp_close", Nat.show(op.port))
    proc_exec: Pair.new<String, String>("proc_exec", op.cmd)
    proc_spawn: Pair.new<String, String>("proc_spawn", op.cmd)
    proc_run:
      let packed = Proc.pack(op.file) | Proc.pack(op.workdir) | Proc.pack(op.environ) | op.args
      Pair.new<String, String>("proc_run", packed)
    proc_spawn_ex:
      let packed = Proc.pack(op.file) | Proc.pack(op.workdir) | Proc.pack(op.environ) | op.args
      Pair.new<String, String>("proc_spawn_ex", packed)
    proc_unsafe_shell: Pair.new<String, String>("proc_unsafe_shell", op.cmd)
    proc_wait: Pair.new<String, String>("proc_wait", Nat.show(op.pid))
    proc_kill: Pair.new<String, String>("proc_kill", Nat.show(op.pid) | "\n" | op.sig)
    job_start: Pair.new<String, String>("job_start", op.spec)
    job_await: Pair.new<String, String>("job_await", op.id)
    job_cancel: Pair.new<String, String>("job_cancel", op.id)
    job_all: Pair.new<String, String>("job_all", op.ids)
    job_race: Pair.new<String, String>("job_race", op.ids)
    gzip: Pair.new<String, String>("gzip", op.text)
    gunzip: Pair.new<String, String>("gunzip", op.hex)
    state_get: Pair.new<String, String>("get_state", op.key)
    state_set: Pair.new<String, String>("set_state", op.key | "\n" | op.val)
    ffi: Pair.new<String, String>("ffi", op.name | "\n" | op.json)
    worker_run: Pair.new<String, String>("worker_run", op.name | "\n" | op.json)
    sse_open: Pair.new<String, String>("sse_open", op.id | "\n" | op.bus)
    sse_send: Pair.new<String, String>("sse_send", op.bus | "\n" | op.frame)
    sse_close: Pair.new<String, String>("sse_close", op.id)
    sse_count: Pair.new<String, String>("sse_count", op.bus)
    db_connect: Pair.new<String, String>("db_connect", op.url)
    db_set: Pair.new<String, String>("db_set", op.id | "\n" | op.key | "\n" | op.val)
    db_del: Pair.new<String, String>("db_del", op.id | "\n" | op.key)
    db_query: Pair.new<String, String>("db_query", op.id | "\n" | op.cmd)
    db_keys: Pair.new<String, String>("db_keys", op.id)
    db_clear: Pair.new<String, String>("db_clear", op.id)
    db_close: Pair.new<String, String>("db_close", op.id)
    fs_open: Pair.new<String, String>("fs_open", op.path)
    fs_read_fd: Pair.new<String, String>("fs_read_fd", op.id)
    fs_close: Pair.new<String, String>("fs_close", op.id)
    fs_temp_push: Pair.new<String, String>("fs_temp_push", op.path)
    fs_temp_pop: Pair.new<String, String>("fs_temp_pop", op.path)
    stream_open: Pair.new<String, String>("stream_open", op.path)
    stream_read: Pair.new<String, String>("stream_read", op.id)
    stream_close: Pair.new<String, String>("stream_close", op.id)
    ws_send: Pair.new<String, String>("ws_send", op.id | "\n" | op.data)
    ws_recv: Pair.new<String, String>("ws_recv", op.id)
    ws_close: Pair.new<String, String>("ws_close", op.id)
  }
