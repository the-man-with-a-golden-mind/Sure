Html.Event.Data.bit(s: String): Bool
  String.eql(s, "1")

Html.Event.Data.at(xs: List<String>, i: Nat): String
  List.head_with_default<String>("", List.drop<String>(i, xs))

Html.Event.Data.parse(raw: String): Html.Event.Data
  let xs = String.split(raw, "\n")
  let n = List.length<String>(xs)
  let key_i = if Nat.lte(n, 13) then 4 else Nat.sub(n, 9)
  let value =
    if Nat.lte(n, 13) then Html.Event.Data.at(xs, 3)
    else String.join("\n", List.take<String>(Nat.sub(n, 12), List.drop<String>(3, xs)))
  Html.Event.Data.new(
    Html.Event.click,
    Html.Event.Data.at(xs, 1),
    Html.Event.Data.at(xs, 2),
    value,
    Html.Event.Data.at(xs, key_i),
    Html.Event.Data.nat(Html.Event.Data.at(xs, Nat.succ(key_i))),
    Html.Event.Data.nat(Html.Event.Data.at(xs, Nat.add(key_i, 2))),
    Html.Event.Data.nat(Html.Event.Data.at(xs, Nat.add(key_i, 3))),
    Html.Event.Data.bit(Html.Event.Data.at(xs, Nat.add(key_i, 4))),
    Html.Event.Data.bit(Html.Event.Data.at(xs, Nat.add(key_i, 5))),
    Html.Event.Data.bit(Html.Event.Data.at(xs, Nat.add(key_i, 6))),
    Html.Event.Data.bit(Html.Event.Data.at(xs, Nat.add(key_i, 7))),
    Html.Event.Data.bit(Html.Event.Data.at(xs, Nat.add(key_i, 8)))
  )
