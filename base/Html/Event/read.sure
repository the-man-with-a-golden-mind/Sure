Html.Event.read.go(s: String, xs: List<Html.Event>): Maybe<Html.Event>
  case xs {
    nil: none
    cons:
      if String.eql(s, Html.Event.show(xs.head)) then some(xs.head)
      else Html.Event.read.go(s, xs.tail)
  }

Html.Event.read(s: String): Maybe<Html.Event>
  Html.Event.read.go(s, Html.Event.all)
