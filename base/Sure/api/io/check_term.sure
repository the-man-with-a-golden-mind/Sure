// TODO: remove duplicate code on Kind/api/io/normalize_term.sure
Sure.api.io.check_term(name: String): IO<Unit>
  IO {
    get defs = Sure.Synth.one(name, Sure.Map.new!)
    case defs {
      none:
        let notfound = "Term not found: '" | name | "'."
        let filelist = List.mapped!(Sure.Synth.files_of(name))!((x) "'" | x | "'")
        let searched = "Searched on: " | String.join(", ",filelist) | "."
        IO.print(notfound | "\n" | searched)
      some: IO {
        IO.print(Sure.Defs.report(defs.value, [name]))
        Sure.Defs.cache.names(defs.value, [name])
      }
    }
  }
