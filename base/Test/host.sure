// Bounded host/runtime checks. Test.main runs Test.ci.suite then this. Not Test.suite.
Test.host.winner(e: Either<String, String>): String
  case e {
    left: e.value
    right: e.value
  }

// Loser of the race is cancelled. Release still runs on a fresh abort scope.
Test.host.bracket: IO<String>
  IO.race<String, String, String>(
    IO.bracket<String, String>(
      IO.end<String>("r"),
      (x) IO {
        get _ = IO.sleep(2000)
        return "USE"
      },
      (x) IO.print("RELEASED")
    ),
    IO {
      get _ = IO.sleep(20)
      return "DONE"
    },
    (w) IO.end<String>(Test.host.winner(w))
  )

Test.host.node: IO<String>
  IO {
    get n = IO.get_env("SURE_NODE")
    return case n {
      none: "node"
      some: if String.is_empty(n.value) then "node" else n.value
    }
  }

Test.host: IO<Unit>
  IO {
    get bin = Test.host.node
    get o = Proc.exec(bin, ["-e", "process.stdout.write('ok')"])
    case o {
      err: IO.print("Test.host fail")
      ok:
        open o.value
        IO {
          IO.print("Test.host " | o.value.stdout)
          get nl = Proc.exec(bin, ["-e", "process.stdout.write(process.argv[1])", "a\nb"])
          case nl {
            err: IO.print("Test.host nl fail")
            ok:
              open nl.value
              IO {
                IO.print("Test.host nl " | nl.value.stdout)
                get e = Test.host.bracket
                IO.print(e)
                get line = IO.race<String, String, String>(
                  IO.get_line,
                  IO.end<String>("FAST"),
                  (w) IO.end<String>(Test.host.winner(w))
                )
                IO.print("Test.host line " | line)
                get http = IO.race<String, String, String>(
                  IO.http("http://127.0.0.1:1/"),
                  IO.end<String>("FAST"),
                  (w) IO.end<String>(Test.host.winner(w))
                )
                IO.print("Test.host http " | http)
              }
          }
        }
    }
  }
