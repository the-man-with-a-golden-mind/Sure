#!/bin/sh
# Install this clone as the global `sure` / `kind` binaries.
# `bun add -g .` is not this: -g changes directory, so `.` becomes an unnamed
# `@` package and Bun reports a dependency loop.
SELF="$0"
while [ -L "$SELF" ]; do
  DIR="$(CDPATH= cd -- "$(dirname "$SELF")" && pwd)"
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$DIR/$LINK" ;;
  esac
done
ROOT="$(CDPATH= cd -- "$(dirname "$SELF")/.." && pwd)"
# bun add -g . writes "bun-global": "." into ~/.bun/install/global and then loops.
GLOBAL_PKG="${HOME}/.bun/install/global/package.json"
if [ -f "$GLOBAL_PKG" ]; then
  python3 - "$GLOBAL_PKG" <<'PY' 2>/dev/null || true
import json, sys
p = sys.argv[1]
with open(p) as f:
    data = json.load(f)
deps = data.get("dependencies") or {}
changed = False
for k in list(deps):
    if k in ("", "bun-global", "@") or deps[k] in (".", "./"):
        del deps[k]
        changed = True
if changed:
    data["dependencies"] = deps
    with open(p, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
PY
fi
if command -v bun >/dev/null 2>&1; then
  bun remove -g sure-lang >/dev/null 2>&1 || true
  bun remove -g @ >/dev/null 2>&1 || true
  exec bun add -g "sure-lang@file:${ROOT}"
fi
if command -v npm >/dev/null 2>&1; then
  exec npm install -g "$ROOT"
fi
echo "need bun or npm to install sure-lang globally" >&2
exit 1
