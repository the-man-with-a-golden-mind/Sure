{
  "name": "sure-lang-cli",
  "private": true,
  "version": "0.1.0",
  "description": "Sure — a fork of Legacy Kind",
  "main": "src/sure.js",
  "scripts": {
    "test": "node test-units.js && node test-lsp-identity.js && node --stack-size=10000 src/main.js test && node test-ui-pages.js && node src/gen-host.js --check && node ../../bootstrap.js --check",
    "test:units": "node test-units.js && node test-lsp-identity.js",
    "test:ui": "node test-ui-pages.js",
    "perf": "node perf/run.js --quick",
    "perf:full": "node perf/run.js",
    "rescript": "rescript",
    "rescript:check": "rescript build && git diff --exit-code -- src/*.res.js"
  },
  "bin": {
    "sure": "src/main.js",
    "kind": "src/main.js"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-man-with-a-golden-mind/Sure.git"
  },
  "author": "Victor Maia",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/the-man-with-a-golden-mind/Sure/issues"
  },
  "homepage": "https://github.com/the-man-with-a-golden-mind/Sure#readme",
  "dependencies": {
    "formcore-js": "file:../../vendor/formcore-js"
  },
  "devDependencies": {
    "rescript": "11.1.4"
  }
}
