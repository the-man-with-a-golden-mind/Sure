#!/bin/sh
# Compatibility alias. The language is Sure; this is the same CLI.
ROOT="$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)"
MAIN="$ROOT/bin/js/src/main.js"
want_bun=0
[ "$SURE_RUNTIME" = "bun" ] && want_bun=1
for a in "$@"; do
  [ "$a" = "--bun" ] && want_bun=1
done
if [ "$want_bun" = 1 ]; then
  if command -v bun >/dev/null 2>&1; then
    exec bun "$MAIN" "$@"
  fi
  echo "kind: bun not found (--bun or SURE_RUNTIME=bun)" >&2
  exit 1
fi
node_ok() {
  "$1" -e 'var m=parseInt(String(process.versions.node).split(".")[0],10); if(!(m>=18)) process.exit(2); if(typeof AbortController!=="function") process.exit(3);' >/dev/null 2>&1
}
pick_node() {
  if [ -n "$SURE_NODE" ]; then
    if node_ok "$SURE_NODE"; then
      printf '%s\n' "$SURE_NODE"
      return 0
    fi
  fi
  _oldifs=$IFS
  IFS=:
  for _dir in $PATH; do
    _n="$_dir/node"
    if [ -x "$_n" ] && node_ok "$_n"; then
      printf '%s\n' "$_n"
      IFS=$_oldifs
      return 0
    fi
  done
  IFS=$_oldifs
  return 1
}
NODE="$(pick_node)" || {
  echo "kind: need Node 18+ with AbortController. Set SURE_NODE to that binary." >&2
  exit 1
}
exec "$NODE" --stack-size=10000 "$MAIN" "$@"
