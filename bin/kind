#!/bin/sh
# Compatibility alias. The language is Sure; this is the same CLI.
# Prefer rust when present. Does not prefer bun as the compiler once rust exists.
# SURE_COMPILER=js forces the JS checker. Missing rust still falls back to JS.
SELF="$0"
while [ -L "$SELF" ]; do
  DIR="$(CDPATH= cd -- "$(dirname "$SELF")" && pwd)"
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$DIR/$LINK" ;;
  esac
done
ROOT="$(CDPATH= cd -- "$(dirname "$SELF")/.." && pwd)"
MAIN="$ROOT/bin/js/src/main.js"
if [ -z "$SURE_BASE" ] && [ -z "$KIND_BASE" ] && [ -f "$ROOT/base/Nat.sure" ]; then
  SURE_BASE="$ROOT/base"
  export SURE_BASE
  KIND_BASE="$SURE_BASE"
  export KIND_BASE
fi
if [ "$SURE_COMPILER" != "js" ]; then
  if [ -x "$ROOT/target/release/sure" ]; then
    exec "$ROOT/target/release/sure" "$@"
  fi
  if [ -x "$ROOT/target/debug/sure" ]; then
    exec "$ROOT/target/debug/sure" "$@"
  fi
  if [ -x "$ROOT/bin/surec" ]; then
    exec "$ROOT/bin/surec" "$@"
  fi
  if command -v surec >/dev/null 2>&1; then
    exec surec "$@"
  fi
fi
want_node=0
[ "$SURE_RUNTIME" = "node" ] && want_node=1
for a in "$@"; do
  [ "$a" = "--node" ] && want_node=1
done
if [ "$want_node" != 1 ] && command -v bun >/dev/null 2>&1; then
  exec bun "$MAIN" "$@"
fi
node_ok() {
  "$1" -e 'var m=parseInt(String(process.versions.node).split(".")[0],10); if(!(m>=18)) process.exit(2); if(typeof AbortController!=="function") process.exit(3);' >/dev/null 2>&1
}
pick_node() {
  if [ -n "$SURE_NODE" ]; then
    if node_ok "$SURE_NODE"; then
      printf '%s\n' "$SURE_NODE"
      return 0
    fi
  fi
  _oldifs=$IFS
  IFS=:
  for _dir in $PATH; do
    _n="$_dir/node"
    if [ -x "$_n" ] && node_ok "$_n"; then
      printf '%s\n' "$_n"
      IFS=$_oldifs
      return 0
    fi
  done
  IFS=$_oldifs
  return 1
}
NODE="$(pick_node)" || {
  echo "kind: need Bun, or Node 18+ with AbortController. Set SURE_NODE to that binary." >&2
  exit 1
}
exec "$NODE" --stack-size=10000 "$MAIN" "$@"
