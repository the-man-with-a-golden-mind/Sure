#!/bin/sh
# Repo-local and globally-linked Sure CLI. `bin/kind` is the same entry point.
# Bun is the default when it is on PATH. Node 18+: SURE_RUNTIME=node or --node.
SELF="$0"
while [ -L "$SELF" ]; do
  DIR="$(CDPATH= cd -- "$(dirname "$SELF")" && pwd)"
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$DIR/$LINK" ;;
  esac
done
ROOT="$(CDPATH= cd -- "$(dirname "$SELF")/.." && pwd)"
MAIN="$ROOT/bin/js/src/main.js"
if [ -z "$SURE_BASE" ] && [ -z "$KIND_BASE" ] && [ -f "$ROOT/base/Nat.sure" ]; then
  SURE_BASE="$ROOT/base"
  export SURE_BASE
  KIND_BASE="$SURE_BASE"
  export KIND_BASE
fi
want_node=0
[ "$SURE_RUNTIME" = "node" ] && want_node=1
for a in "$@"; do
  [ "$a" = "--node" ] && want_node=1
done
if [ "$want_node" != 1 ] && command -v bun >/dev/null 2>&1; then
  exec bun "$MAIN" "$@"
fi
node_ok() {
  "$1" -e 'var m=parseInt(String(process.versions.node).split(".")[0],10); if(!(m>=18)) process.exit(2); if(typeof AbortController!=="function") process.exit(3);' >/dev/null 2>&1
}
pick_node() {
  if [ -n "$SURE_NODE" ]; then
    if node_ok "$SURE_NODE"; then
      printf '%s\n' "$SURE_NODE"
      return 0
    fi
  fi
  _oldifs=$IFS
  IFS=:
  for _dir in $PATH; do
    _n="$_dir/node"
    if [ -x "$_n" ] && node_ok "$_n"; then
      printf '%s\n' "$_n"
      IFS=$_oldifs
      return 0
    fi
  done
  IFS=$_oldifs
  return 1
}
NODE="$(pick_node)" || {
  echo "sure: need Bun, or Node 18+ with AbortController. Set SURE_NODE to that binary." >&2
  exit 1
}
exec "$NODE" --stack-size=10000 "$MAIN" "$@"
