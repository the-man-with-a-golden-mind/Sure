IO.ask: %(A:*) @(query:String) @(param:String) @(then:@(response:String) (IO A)) (IO A) = #A #query #param #then #P #end #ask #par #race #bracket (((ask query) param) then);
Unit: * = %Unit.Self(P:@(:Unit) *) @(new:(P Unit.new)) (P Unit.Self);
IO.end: %(A:*) @(value:A) (IO A) = #A #value #P #end #ask #par #race #bracket (end value);
Unit.new: Unit = #P #new new;
IO.put_string: @(text:String) (IO Unit) = #text ((((IO.ask Unit) "put_string") text) #skip ((IO.end Unit) Unit.new));
String: * = %String.Self(P:@(:String) *) @(nil:(P String.nil)) @(cons:@(head:Char) @(tail:String) (P ((String.cons head) tail))) (P String.Self);
String.cons: @(head:Char) @(tail:String) String = #head #tail #P #nil #cons ((cons head) tail);
String.concat: @(as:String) @(bs:String) String = #as #bs (((as #as String) bs) #as.head #as.tail ((String.cons as.head) ((String.concat as.tail) bs)));
IO.print: @(text:String) (IO Unit) = #text (IO.put_string ((String.concat text) "\u{a}"));
Hello.greet: String = "Sure";
Hello.demo: (IO Unit) = (IO.print Hello.greet);
Main: (IO Unit) = Hello.demo;

